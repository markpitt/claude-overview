{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Overview",
  "version": "0.1.0",
  "identifier": "dev.markpitt.claudeoverview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Overview",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "popover",
        "title": "Claude Overview",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Claude usage, plan, waiting work and status in your tray",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
