---
// A screenshot with its light twin: the dark one in the dark theme, the light one in the light.
import type { ImageMetadata } from 'astro';

export interface Props {
  dark: ImageMetadata;
  light?: ImageMetadata;
  alt: string;
  caption?: string;
}
const { dark, light, alt, caption } = Astro.props;
---

<figure class="co-shot">
  <img class:list={['co-shot-img', light && 'co-shot-dark']} src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
  {light && <img class="co-shot-img co-shot-light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
